{
  "name": "ccphone",
  "version": "0.1.0",
  "description": "Access your Claude Code terminal from iPhone via web-based terminal",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ccphone": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "node src/index.ts",
    "start": "node dist/index.js",
    "lint": "oxlint --tsconfig tsconfig.json --type-aware src/",
    "fmt": "oxfmt --write src/",
    "fmt:check": "oxfmt --check src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "oxfmt": "^0.1.0",
    "oxlint": "^1.0.0",
    "oxlint-tsgolint": "^0.14.2",
    "tsdown": "^0.12.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "esbuild"
    ]
  }
}
